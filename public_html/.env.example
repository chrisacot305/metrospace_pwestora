# =====================================================================
#  Pwestora settings — copy this file to ".env" and fill in real values.
#  NEVER upload .env to GitHub or share it. (.gitignore already excludes it.)
#
#  Where to put .env on Hostinger (pick ONE):
#    Recommended: /home/<user>/domains/pwestora.com/.env   (one folder ABOVE public_html)
#    Also works:  public_html/.env                         (blocked by .htaccess)
# =====================================================================

# --- Application ---
APP_NAME=Pwestora
APP_URL=https://pwestora.com
APP_ENV=production
# true shows PHP errors in the browser — ONLY for local testing
APP_DEBUG=false
# APP_TIMEZONE=Asia/Manila

# --- Database (hPanel → Databases → MySQL Databases) ---
DB_HOST=localhost
DB_NAME=u000000000_pwestora
DB_USER=u000000000_pwestora
DB_PASS="change-me"

# --- Email (hPanel → Emails → mailbox → Configuration) ---
MAIL_DRIVER=smtp
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=admin@pwestora.com
SMTP_PASS="change-me"
SMTP_FROM_NAME=Pwestora

# --- SMS (PhilSMS) ---
SMS_DRIVER=philsms
PHILSMS_API_TOKEN="change-me"
PHILSMS_SENDER_ID=PhilSMS
PHILSMS_API_URL=https://dashboard.philsms.com/api/v3/sms/send

# --- Security ---
# Long random string. Needed only if the cron job is called over the web (?token=...).
# Generate one: php -r "echo bin2hex(random_bytes(24));"
CRON_SECRET_KEY=
# Log out after this many seconds of inactivity (7200 = 2 hours)
SESSION_LIFETIME=7200
# One-time key for running tools/migrate.php in the browser. Remove after use.
MIGRATE_KEY=

# --- Mobile app API ---
# NEVER true on the live server (allows API access without login, for demos only)
API_DEMO_MODE=false
API_ALLOWED_ORIGIN=*
