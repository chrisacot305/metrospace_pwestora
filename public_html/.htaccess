# ------------------------------------------------------------------
# Pwestora — public_html/.htaccess  (Hostinger: Apache / LiteSpeed)
# ------------------------------------------------------------------
DirectoryIndex index.php
Options -Indexes

# Never serve secrets, internal code or tooling files
<FilesMatch "^(\.env.*|\.git.*|\.htaccess|\.user\.ini|composer\.(json|lock)|.*\.(sql|log|bak|sh|md|ini|dist))$">
  Require all denied
</FilesMatch>
# (README.md / docs are not needed on the server; this also blocks them.)

RewriteEngine On

# Force HTTPS (Hostinger issues a free SSL cert on your domain)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Block direct web access to internal folders (also protected by their own .htaccess)
RewriteRule ^(app|docs|backup)(/|$) - [F,L]

# Pass Authorization header to PHP (prevents Apache/FastCGI stripping Bearer tokens for the mobile API)
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization"
</IfModule>
